APP_NAME="Hotel HAR Official"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
HOTEL_WHATSAPP=6289667875415
HOTEL_SUPPORT_EMAIL=vibecode812@gmail.com

# Google OAuth credentials for customer sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL="${APP_URL}/auth/google/callback"

# Configure only payment destinations that really belong to the hotel. These are manually verified.
PAYMENT_BCA_VA_NUMBER="08973214"
PAYMENT_BCA_ACCOUNT_NAME="hospitar-har"
PAYMENT_MANDIRI_VA_NUMBER="908732132"
PAYMENT_MANDIRI_ACCOUNT_NAME="hospitar-har"
PAYMENT_BRI_NUMBER=""
PAYMENT_BRI_ACCOUNT_NAME=""
PAYMENT_GOPAY_RECIPIENT="gopay@hospital-har.com"
PAYMENT_GOPAY_ACCOUNT_NAME="hospitar-har"
PAYMENT_OVO_RECIPIENT="ovo@hospital-har.com"
PAYMENT_OVO_ACCOUNT_NAME="hospitar-har"
PAYMENT_DANA_RECIPIENT="dana@hospital-har.com"
PAYMENT_DANA_ACCOUNT_NAME="hospital-har"
PAYMENT_SHOPEEPAY_RECIPIENT=""
PAYMENT_SHOPEEPAY_ACCOUNT_NAME=""
PAYMENT_QRIS_IMAGE="assets/qris-hotel.png"
PAYMENT_QRIS_ACCOUNT_NAME=""
# Comma-separated email addresses allowed to review uploaded transfer proofs.
PAYMENT_ADMIN_EMAILS=hotel-har@gmail.com
PAYMENT_EXPIRY_HOURS=24

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=reservasi_hotel
DB_USERNAME=root
DB_PASSWORD=

LOG_CHANNEL=stack
LOG_LEVEL=debug

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=file
QUEUE_CONNECTION=sync

# Password reset links expire after 24 hours; resend requests remain throttled.
AUTH_PASSWORD_RESET_EXPIRE=1440

# Gmail SMTP: enable 2-Step Verification, then create an App Password.
# Set APP_URL to a domain or a LAN/tunnel URL reachable from the phone opening the email.
# Do not use your regular Google account password. Keep the App Password private in .env.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_TIMEOUT=10
MAIL_USERNAME=your-address@gmail.com
MAIL_PASSWORD=
MAIL_SCHEME=smtp
MAIL_FROM_ADDRESS="${MAIL_USERNAME}"
MAIL_FROM_NAME="${APP_NAME}"
